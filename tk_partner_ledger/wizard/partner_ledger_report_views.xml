<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="partner_ledger_wizard_form_view" model="ir.ui.view">
            <field name="name">partner.ledger.wizard.form.view</field>
            <field name="model">partner.ledger.report</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <div invisible="not report_html" style="max-height: 60vh; overflow-y: auto; overflow-x: auto; margin-top: 15px; margin-bottom: 15px; border: 1px solid #dee2e6; border-radius: 4px; padding: 15px; background: #ffffff;">
                        <field name="report_html" widget="html" readonly="1" nolabel="1"/>
                    </div>
                    <footer>
                        <div style="display: flex; justify-content: center; align-items: center;">
                            <button name="btn_preview_action" string="Preview" type="object" class="oe_highlight"/>
                            <span style="vertical-align: middle; margin: 0 5px;">or</span>
                            <button name="btn_pdf_action" string="PDF" type="object" class="oe_highlight"/>
                            <span style="vertical-align: middle; margin: 0 5px;">or</span>
                            <button name="btn_excel_action" string="Excel" type="object" class="oe_highlight"/>
                            <span style="margin: 0 5px;">or</span>
                            <button special="cancel" string="Cancel" type="object" class="oe_highlight"/>
                        </div>
                    </footer>
                </form>
            </field>
        </record>
        <record id="partner_ledger_wizard_action" model="ir.actions.act_window">
            <field name="name">Partner Ledger</field>
            <field name="res_model">partner.ledger.report</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'dialog_size': 'extra-large'}</field>
        </record>

        <!-- Menu entry under Accounting / Reporting -->
        <menuitem id="menu_partner_ledger_report"
                  name="Updated Partner Ledger"
                  parent="account.menu_finance_reports"
                  action="partner_ledger_wizard_action"
                  sequence="90"/>
        <record id="partner_ledger_wizard_action_open" model="ir.actions.server">
            <field name="name">Partner Ledger</field>
            <field name="model_id" ref="tk_partner_ledger.model_res_partner"/>
            <field name="binding_model_id" ref="tk_partner_ledger.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_wizard_ledger()</field>
        </record>
    </data>
</odoo>
