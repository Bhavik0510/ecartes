<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="paperformat_tk_partner_ledger" model="report.paperformat">
            <field name="name">Partner Ledger Paperformat</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <template id="report_partner_ledger_main">
            <style>
                .page, .page * {
                    box-sizing: border-box;
                }
                .article, .page {
                    border: none !important;
                    outline: none !important;
                    box-shadow: none !important;
                }
                .article::before, .article::after,
                .page::before, .page::after,
                table::before, table::after,
                div::before, div::after {
                    display: none !important;
                    border: none !important;
                    content: none !important;
                }
                .tally-table {
                    display: table !important;
                    width: 100% !important;
                    border: none !important;
                    outline: none !important;
                    box-shadow: none !important;
                    border-collapse: separate !important;
                    border-spacing: 0 !important;
                    font-size: 11px;
                    font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
                    color: #000;
                }
                .tally-thead {
                    display: table-header-group !important;
                    border: none !important;
                }
                .tally-tbody {
                    display: table-row-group !important;
                    border: none !important;
                }
                .tally-tr {
                    display: table-row !important;
                    border: none !important;
                    page-break-inside: avoid !important;
                }
                .tally-th {
                    display: table-cell !important;
                    border: none !important;
                    border-top: 1px solid #000 !important;
                    border-bottom: 1px solid #000 !important;
                    border-left: none !important;
                    border-right: none !important;
                    padding: 4px 2px !important;
                    font-weight: bold !important;
                    vertical-align: middle !important;
                }
                .tally-td {
                    display: table-cell !important;
                    border: none !important;
                    border-top: none !important;
                    border-bottom: none !important;
                    border-left: none !important;
                    border-right: none !important;
                    padding: 2px 2px !important;
                    vertical-align: top !important;
                }
            </style>

            <div class="page" style="font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif; font-size: 11px; color: #000; line-height: 1.35; border: none !important; max-width: 850px; margin: 0 auto; background: #fff;">
                <!-- Company Header (Centered) -->
                <div style="text-align: center; margin-bottom: 12px; border: none !important;">
                    <div style="font-size: 15px; font-weight: bold; margin-bottom: 2px; border: none !important;">
                        <t t-esc="company.name"/>
                    </div>
                    <t t-foreach="company_address_lines" t-as="addr">
                        <div style="font-size: 11.5px; line-height: 1.3; border: none !important;">
                            <t t-esc="addr"/>
                        </div>
                    </t>
                    <div t-if="company_cin" style="font-size: 11.5px; line-height: 1.3; border: none !important;">
                        CIN No. <t t-esc="company_cin"/>
                    </div>
                </div>

                <!-- Partner Details (Centered) -->
                <div style="text-align: center; margin-bottom: 12px; border: none !important;">
                    <div style="font-size: 15px; font-weight: bold; margin-bottom: 2px; border: none !important;">
                        <t t-esc="partner.name"/>
                    </div>
                    <div style="font-size: 12px; margin-bottom: 2px; border: none !important;">
                        Ledger Account
                    </div>
                    <t t-foreach="partner_address_lines" t-as="p_addr">
                        <div style="font-size: 11px; line-height: 1.3; border: none !important;">
                            <t t-esc="p_addr"/>
                        </div>
                    </t>
                </div>

                <!-- Period & Page line (DIVs with NO borders) -->
                <div style="width: 100%; margin-bottom: 6px; position: relative; border: none !important;">
                    <div style="text-align: center; font-size: 11.5px; color: #000; border: none !important;">
                        <t t-esc="period_label"/>
                    </div>
                    <div style="position: absolute; right: 0; top: 0; font-size: 11px; color: #000; border: none !important;">
                        Page <span class="page"/>
                    </div>
                </div>

                <!-- Ledger Layout (Pure DIV table - completely eliminates outer box and table border artifacts) -->
                <div class="tally-table">
                    <!-- Table Header -->
                    <div class="tally-thead">
                        <div class="tally-tr">
                            <div class="tally-th" style="width: 11%; text-align: left;">Date</div>
                            <div class="tally-th" style="width: 37%; text-align: left;">Particulars</div>
                            <div class="tally-th" style="width: 15%; text-align: left;">Vch Type</div>
                            <div class="tally-th" style="width: 13%; text-align: right; padding-right: 4px;">Vch No.</div>
                            <div class="tally-th" style="width: 12%; text-align: right;">Debit</div>
                            <div class="tally-th" style="width: 12%; text-align: right;">Credit</div>
                        </div>
                    </div>

                    <!-- Table Body -->
                    <div class="tally-tbody">
                        <!-- Opening Balance Row -->
                        <div class="tally-tr">
                            <div class="tally-td" style="width: 11%; text-align: left;">
                                <t t-esc="opening_date"/>
                            </div>
                            <div class="tally-td" style="width: 37%; text-align: left; font-weight: bold;">
                                <t t-esc="opening_particulars"/>
                            </div>
                            <div class="tally-td" style="width: 15%;">&#160;</div>
                            <div class="tally-td" style="width: 13%;">&#160;</div>
                            <div class="tally-td" style="width: 12%; text-align: right; font-weight: bold;">
                                <t t-esc="opening_debit_formatted"/>
                            </div>
                            <div class="tally-td" style="width: 12%; text-align: right; font-weight: bold;">
                                <t t-esc="opening_credit_formatted"/>
                            </div>
                        </div>

                        <!-- Transactions Rows -->
                        <t t-foreach="lines" t-as="line">
                            <div class="tally-tr">
                                <div class="tally-td" style="width: 11%; text-align: left;">
                                    <t t-esc="line['display_date']"/>
                                </div>
                                <div class="tally-td" style="width: 37%; text-align: left;">
                                    <t t-esc="line['particulars']"/>
                                </div>
                                <div class="tally-td" style="width: 15%; text-align: left;">
                                    <t t-esc="line['vch_type']"/>
                                </div>
                                <div class="tally-td" style="width: 13%; text-align: right; padding-right: 4px;">
                                    <t t-esc="line['vch_no']"/>
                                </div>
                                <div class="tally-td" style="width: 12%; text-align: right;">
                                    <t t-esc="line['debit_formatted']"/>
                                </div>
                                <div class="tally-td" style="width: 12%; text-align: right;">
                                    <t t-esc="line['credit_formatted']"/>
                                </div>
                            </div>
                        </t>

                        <!-- Subtotal Row (before closing balance) -->
                        <div class="tally-tr">
                            <div class="tally-td" style="width: 11%;">&#160;</div>
                            <div class="tally-td" style="width: 37%;">&#160;</div>
                            <div class="tally-td" style="width: 15%;">&#160;</div>
                            <div class="tally-td" style="width: 13%;">&#160;</div>
                            <div class="tally-td" style="width: 12%; text-align: right; border-top: 1px solid #000; font-size: 11px;">
                                <t t-esc="subtotal_debit_formatted"/>
                            </div>
                            <div class="tally-td" style="width: 12%; text-align: right; border-top: 1px solid #000; font-size: 11px;">
                                <t t-esc="subtotal_credit_formatted"/>
                            </div>
                        </div>

                        <!-- Closing Balance Row -->
                        <div class="tally-tr">
                            <div class="tally-td" style="width: 11%;">&#160;</div>
                            <div class="tally-td" style="width: 37%; text-align: left; font-weight: bold;">
                                <t t-esc="closing_particulars"/>
                            </div>
                            <div class="tally-td" style="width: 15%;">&#160;</div>
                            <div class="tally-td" style="width: 13%;">&#160;</div>
                            <div class="tally-td" style="width: 12%; text-align: right;">
                                <t t-esc="closing_debit_formatted"/>
                            </div>
                            <div class="tally-td" style="width: 12%; text-align: right;">
                                <t t-esc="closing_credit_formatted"/>
                            </div>
                        </div>

                        <!-- Grand Total Row -->
                        <div class="tally-tr">
                            <div class="tally-td" style="width: 11%;">&#160;</div>
                            <div class="tally-td" style="width: 37%;">&#160;</div>
                            <div class="tally-td" style="width: 15%;">&#160;</div>
                            <div class="tally-td" style="width: 13%;">&#160;</div>
                            <div class="tally-td" style="width: 12%; text-align: right; font-weight: bold; border-top: 1px solid #000; padding: 4px 2px;">
                                <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
                                    <div style="border-bottom: 1px solid #000; padding-bottom: 1px;">
                                        <t t-esc="grand_total_debit_formatted"/>
                                    </div>
                                </div>
                            </div>
                            <div class="tally-td" style="width: 12%; text-align: right; font-weight: bold; border-top: 1px solid #000; padding: 4px 2px;">
                                <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
                                    <div style="border-bottom: 1px solid #000; padding-bottom: 1px;">
                                        <t t-esc="grand_total_credit_formatted"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <template id="report_partner_ledger_pdf">
            <t t-call="web.basic_layout">
                <t t-call="tk_partner_ledger.report_partner_ledger_main"/>
            </t>
        </template>

        <record id="action_report_partner_ledger" model="ir.actions.report">
            <field name="name">Partner Ledger Report</field>
            <field name="model">partner.ledger.report</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">tk_partner_ledger.report_partner_ledger_pdf</field>
            <field name="report_file">tk_partner_ledger.report_partner_ledger_pdf</field>
            <field name="binding_model_id" ref="model_partner_ledger_report"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="tk_partner_ledger.paperformat_tk_partner_ledger"/>
            <field name="print_report_name">'%s - Partner Ledger' % (object.partner_id.name if object.partner_id else 'Partner')</field>
        </record>

        <record id="action_report_partner_ledger_html" model="ir.actions.report">
            <field name="name">Partner Ledger Preview</field>
            <field name="model">partner.ledger.report</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">tk_partner_ledger.report_partner_ledger_pdf</field>
            <field name="report_file">tk_partner_ledger.report_partner_ledger_pdf</field>
            <field name="paperformat_id" ref="tk_partner_ledger.paperformat_tk_partner_ledger"/>
        </record>
    </data>
</odoo>
