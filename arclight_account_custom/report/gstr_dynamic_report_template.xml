<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat for GSTR Report (Landscape for detailed tables) -->
    <record id="paperformat_gstr_report" model="report.paperformat">
        <field name="name">GSTR Dynamic Report Paperformat</field>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- Report Action -->
    <record id="action_print_gstr_dynamic_report" model="ir.actions.report">
        <field name="name">GSTR Dynamic Report</field>
        <field name="model">gstr.dynamic.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">arclight_account_custom.gstr_dynamic_report_pdf</field>
        <field name="report_file">arclight_account_custom.gstr_dynamic_report_pdf</field>
        <field name="paperformat_id" ref="paperformat_gstr_report"/>
    </record>

    <!-- QWeb Template -->
    <template id="gstr_dynamic_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #333;">
                    
                    <style>
                        .header-no-border, .header-no-border tr, .header-no-border td {
                            border: none !important;
                            border-style: hidden !important;
                        }
                    </style>

                    <!-- Clean Company Header (No outer border) -->
                    <table class="header-no-border" style="width: 100%; border: none !important; margin-bottom: 12px; border-collapse: separate; border-spacing: 0;">
                        <tr style="border: none !important;">
                            <td style="vertical-align: top; width: 60%; border: none !important; padding: 0;">
                                <h3 style="margin: 0; font-weight: 700; color: #1a365d; font-size: 16px;">
                                    <t t-esc="company.name"/>
                                </h3>
                                <div style="font-size: 10px; color: #555; margin-top: 3px; line-height: 1.3;">
                                    <t t-if="company.street"><t t-esc="company.street"/>, </t>
                                    <t t-if="company.street2"><t t-esc="company.street2"/>, </t>
                                    <t t-if="company.city"><t t-esc="company.city"/> </t>
                                    <t t-if="company.zip">- <t t-esc="company.zip"/></t>
                                    <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                                </div>
                                <div style="font-size: 11px; font-weight: bold; color: #222; margin-top: 3px;">
                                    GSTIN: <t t-esc="company.vat or ''"/>
                                </div>
                            </td>
                            <td style="vertical-align: top; width: 40%; text-align: right; border: none !important; padding: 0;">
                                <h2 style="margin: 0; font-weight: 700; color: #2c3e50; font-size: 18px; text-transform: uppercase;">
                                    <t t-esc="report_name"/>
                                </h2>
                                <div style="font-size: 11px; color: #444; margin-top: 4px;">
                                    <strong>Period: </strong><t t-esc="date_from"/> to <t t-esc="date_to"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Top Bar: GSTIN & Period -->
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 4px; margin-bottom: 6px; font-weight: bold; font-size: 10px;">
                        <div>
                            GSTIN : <t t-esc="company_gstin or company.vat or ''"/>
                        </div>
                        <div>
                            <t t-esc="period_display or (date_from + ' to ' + date_to)"/>
                        </div>
                    </div>

                    <!-- Voucher Summary Box -->
                    <t t-if="vouchers_summary">
                        <div style="border: 1px solid #ccc; background-color: #fafafa; margin-bottom: 10px; font-size: 9px;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <tr style="background-color: #f0f0f0; border-bottom: 1px solid #ddd; font-weight: bold;">
                                    <td style="padding: 3px 6px;">Particulars</td>
                                    <td style="padding: 3px 6px; text-align: right; width: 120px;">Voucher Count</td>
                                </tr>
                                <tr style="font-weight: bold;">
                                    <td style="padding: 2px 6px;">Total Vouchers</td>
                                    <td style="padding: 2px 6px; text-align: right;"><t t-esc="vouchers_summary.get('total_vouchers', 0)"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px 2px 18px;">Included in Return</td>
                                    <td style="padding: 2px 6px; text-align: right;"><t t-esc="vouchers_summary.get('included_in_return', 0)"/></td>
                                </tr>
                                <tr style="color: #666; font-style: italic; font-size: 8.5px;">
                                    <td style="padding: 1px 6px 1px 36px;">Included in HSN/SAC Summary</td>
                                    <td style="padding: 1px 6px; text-align: right;"><t t-esc="vouchers_summary.get('included_in_hsn', 0)"/></td>
                                </tr>
                                <tr style="color: #666; font-style: italic; font-size: 8.5px;">
                                    <td style="padding: 1px 6px 1px 36px;">Incomplete Information in HSN/SAC Summary (Corrections needed)</td>
                                    <td style="padding: 1px 6px; text-align: right;"><t t-esc="vouchers_summary.get('incomplete_hsn', 0)"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px 2px 18px;">Not relevant in this Return</td>
                                    <td style="padding: 2px 6px; text-align: right;"><t t-esc="vouchers_summary.get('not_relevant', 0)"/></td>
                                </tr>
                                <tr>
                                    <td style="padding: 2px 6px 2px 18px;">Uncertain Transactions (Corrections needed)</td>
                                    <td style="padding: 2px 6px; text-align: right;"><t t-esc="vouchers_summary.get('uncertain', 0)"/></td>
                                </tr>
                            </table>
                        </div>
                    </t>

                    <!-- Executive Summary Table (Tally Format) -->
                    <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; margin-top: 0; margin-bottom: 8px; font-size: 8.5px;">
                        <thead style="background-color: #f1f3f5;">
                            <tr style="border-top: 1px solid #777; border-bottom: 2px solid #555;">
                                <th style="width: 25px; padding: 4px 2px; text-align: center; vertical-align: bottom;">Sl<br/>No.</th>
                                <th style="padding: 4px 6px; vertical-align: bottom;">P a r t i c u l a r s</th>
                                <th style="padding: 4px 6px; text-align: right; width: 60px; vertical-align: bottom;">Voucher<br/>Count</th>
                                <th style="padding: 4px 6px; text-align: right; width: 85px; vertical-align: bottom;">Taxable Amount</th>
                                <th style="padding: 4px 6px; text-align: right; width: 80px; vertical-align: bottom;">Integrated Tax<br/>Amount</th>
                                <th style="padding: 4px 6px; text-align: right; width: 75px; vertical-align: bottom;">Central Tax<br/>Amount</th>
                                <th style="padding: 4px 6px; text-align: right; width: 75px; vertical-align: bottom;">State Tax<br/>Amount</th>
                                <th style="padding: 4px 6px; text-align: right; width: 60px; vertical-align: bottom;">Cess Amount</th>
                                <th style="padding: 4px 6px; text-align: right; width: 75px; vertical-align: bottom;">Tax Amount</th>
                                <th style="padding: 4px 6px; text-align: right; width: 85px; vertical-align: bottom;">Invoice Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="sections and len(sections) &gt; 0">
                                <t t-foreach="sections" t-as="sec">
                                    <tr style="border-bottom: 1px solid #dee2e6;">
                                        <td style="text-align: center; color: #666; padding: 3px 2px;">
                                            <t t-esc="sec.get('sr_no', sec_index + 1)"/>
                                        </td>
                                        <td style="padding: 3px 6px; font-weight: 500;">
                                            <t t-esc="sec.get('section')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right;">
                                            <t t-esc="sec.get('doc_count_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-family: monospace;">
                                            <t t-esc="sec.get('taxable_value_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-family: monospace;">
                                            <t t-esc="sec.get('igst_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-family: monospace;">
                                            <t t-esc="sec.get('cgst_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-family: monospace;">
                                            <t t-esc="sec.get('sgst_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-family: monospace;">
                                            <t t-esc="sec.get('cess_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-family: monospace;">
                                            <t t-esc="sec.get('tax_amount_display', '')"/>
                                        </td>
                                        <td style="padding: 3px 6px; text-align: right; font-weight: 600; font-family: monospace;">
                                            <t t-esc="sec.get('invoice_amount_display', '')"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="10" style="text-align: center; padding: 12px; color: #888;">
                                        No records found for the selected period
                                    </td>
                                </tr>
                            </t>

                            <!-- Total Row -->
                            <tr style="background-color: #f1f3f5; font-weight: bold; border-top: 2px solid #555; border-bottom: 2px solid #555;">
                                <td></td>
                                <td style="padding: 4px 6px; font-weight: bold;">Total</td>
                                <td style="padding: 4px 6px; text-align: right;">
                                    <t t-esc="totals.get('doc_count_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-family: monospace;">
                                    <t t-esc="totals.get('taxable_value_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-family: monospace;">
                                    <t t-esc="totals.get('igst_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-family: monospace;">
                                    <t t-esc="totals.get('cgst_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-family: monospace;">
                                    <t t-esc="totals.get('sgst_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-family: monospace;">
                                    <t t-esc="totals.get('cess_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-family: monospace;">
                                    <t t-esc="totals.get('tax_amount_display', '')"/>
                                </td>
                                <td style="padding: 4px 6px; text-align: right; font-weight: bold; font-family: monospace;">
                                    <t t-esc="totals.get('invoice_amount_display', '')"/>
                                </td>
                            </tr>

                            <!-- Bottom Rows -->
                            <tr style="border-bottom: 1px solid #dee2e6;">
                                <td></td>
                                <td colspan="9" style="padding: 3px 6px; font-weight: 500;">HSN/SAC Summary - 12</td>
                            </tr>
                            <tr style="border-bottom: 1px solid #dee2e6;">
                                <td></td>
                                <td colspan="9" style="padding: 3px 6px; font-weight: 500;">Document Summary - 13</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Footnote -->
                    <div style="font-size: 8px; color: #888; font-style: italic; margin-bottom: 15px;">
                        Note: Voucher count and values are not provided for HSN/SAC Summary and Document Summary. Drill down for details.
                    </div>

                    <!-- Detailed Tables (Directly from the Excel report) -->
                    <t t-if="tables and len(tables) &gt; 0">
                        <t t-foreach="tables" t-as="tbl">
                            <div style="page-break-before: always; padding-top: 5px;">
                                <!-- Sheet / Table Banner -->
                                <table style="width: 100%; border: none !important; border-collapse: collapse; margin-bottom: 0;">
                                    <tr style="border: none !important;">
                                        <td style="text-align: left; vertical-align: middle; background-color: #1a365d; color: #ffffff; padding: 5px 8px; font-weight: bold; font-size: 10.5px; border: none !important;">
                                            <t t-esc="tbl.get('title')"/>
                                        </td>
                                        <td style="text-align: right; vertical-align: middle; background-color: #1a365d; color: #ffffff; padding: 5px 8px; font-size: 9.5px; border: none !important;">
                                            Records: <t t-esc="tbl.get('row_count')"/> | Period: <t t-esc="date_from"/> to <t t-esc="date_to"/>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Data Table -->
                                <table class="table table-sm table-bordered" style="width: 100%; border-collapse: collapse; font-size: 8px; margin-top: 0; margin-bottom: 15px; page-break-inside: auto;">
                                    <thead style="background-color: #2c3e50; color: #ffffff; display: table-header-group;">
                                        <tr>
                                            <th style="width: 25px; padding: 4px 2px; border: 1px solid #1a252f; font-weight: 600; text-align: center; vertical-align: middle;">#</th>
                                            <t t-foreach="tbl.get('headers')" t-as="col_name">
                                                <th style="padding: 4px 4px; border: 1px solid #1a252f; font-weight: 600; text-align: center; vertical-align: middle;">
                                                    <t t-esc="col_name"/>
                                                </th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="tbl.get('rows')" t-as="row">
                                            <tr style="page-break-inside: avoid; border-bottom: 1px solid #dee2e6;">
                                                <td style="text-align: center; color: #777; font-size: 7.5px; border: 1px solid #dee2e6; vertical-align: middle; padding: 2px;">
                                                    <t t-esc="row_index + 1"/>
                                                </td>
                                                <t t-foreach="row" t-as="val">
                                                    <td t-att-style="'padding: 3px 4px; border: 1px solid #dee2e6; vertical-align: middle; ' + (val and (val.endswith('%') or val.replace(',', '').replace('.', '').replace('-', '').isdigit()) and 'text-align: right;' or 'text-align: left;')">
                                                        <t t-esc="val"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </t>

                </div>

                <!-- Footer with Page Numbers -->
                <div class="footer" style="font-size: 8.5px; color: #666; border-top: 1px solid #dee2e6; padding-top: 3px;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="text-align: left; border: none;">
                                <t t-esc="company.name"/> | <t t-esc="report_name"/> (<t t-esc="date_from"/> to <t t-esc="date_to"/>)
                            </td>
                            <td style="text-align: right; border: none;">
                                Page <span class="page"/> of <span class="topage"/>
                            </td>
                        </tr>
                    </table>
                </div>

            </t>
        </t>
    </template>
</odoo>
